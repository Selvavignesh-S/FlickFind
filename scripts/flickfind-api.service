[Unit]
Description=FlickFind API and web app (port 8000)
After=network-online.target

[Service]
# Edit the path if the project lives elsewhere.
WorkingDirectory=%h/Documents/FlickFind
ExecStart=/usr/bin/uv run uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
