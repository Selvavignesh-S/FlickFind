# Copy to .env and fill in. Never commit .env.

# --- Needed from the start ---
# TMDB "API Read Access Token" (starts with eyJ...), not the short API key
TMDB_API_TOKEN=
# api.themoviedb.org is blocked by some Indian ISPs' DNS; api.tmdb.org is the same API
TMDB_API_BASE=https://api.tmdb.org/3
# Google AI Studio -> Get API key
GEMINI_API_KEY=

# --- Needed later ---
# Backup chat AI (console.groq.com)
GROQ_API_KEY=
# Private Backblaze B2 bucket + application key limited to that bucket
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# e.g. https://s3.us-west-004.backblazeb2.com (shown on the bucket page)
B2_ENDPOINT=
# Rotten Tomatoes scores (omdbapi.com, key arrives by email)
OMDB_API_KEY=
# Optional backup web search (tavily.com)
TAVILY_API_KEY=

# --- Local services ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Phase 2: Kaggle free GPUs for the bulk mood-profile run.
# Kaggle -> Settings -> API -> Generate New Token, then copy the token shown; username is your Kaggle handle
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# Where the dataset lives (catalog, caches, user database). Default: data/ in this checkout.
# Point other checkouts at one folder so they share it, e.g. FLICKFIND_DATA=~/Documents/FlickFind/data
FLICKFIND_DATA=
